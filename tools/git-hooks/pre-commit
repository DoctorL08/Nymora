#!/bin/sh
# =============================================================================
# Nymora — pre-commit hook
# Bloque les commits qui violent les regles Photon Quantum (determinisme).
#
# Paths scannes (code de SIMULATION uniquement) :
#   - Assets/QuantumUser/Simulation/**/*.cs (sauf Generated/ qui est auto-genere du DSL)
#   - Assets/_Nymora/Scripts/Combat/**/*.cs (sauf View/ qui est du rendu Unity)
#
# Le code View Unity (Assets/_Nymora/Scripts/Combat/View/) peut legitimement
# utiliser Time.deltaTime pour des lerps / animations. Seule la SIMU est
# soumise au verrou determinisme.
# =============================================================================

staged_sim=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^Assets/QuantumUser/Simulation/.*\.cs$' | grep -v '/Generated/' || true)
staged_combat_logic=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^Assets/_Nymora/Scripts/Combat/.*\.cs$' | grep -v '^Assets/_Nymora/Scripts/Combat/View/' | grep -v '^Assets/_Nymora/Scripts/Combat/Replay/' | grep -v '^Assets/_Nymora/Scripts/Combat/Spectate/' || true)

staged=$(printf "%s\n%s" "$staged_sim" "$staged_combat_logic" | sed '/^$/d')

if [ -z "$staged" ]; then
  exit 0
fi

forbidden='Random\.Range|UnityEngine\.Random|Time\.time|Time\.deltaTime|Time\.fixedDeltaTime|Time\.realtimeSinceStartup|DateTime\.Now|DateTime\.UtcNow'

violations=""
for f in $staged; do
  if [ -f "$f" ]; then
    matches=$(grep -nE "$forbidden" "$f" || true)
    if [ -n "$matches" ]; then
      violations="${violations}\n--- $f ---\n$matches"
    fi
  fi
done

if [ -n "$violations" ]; then
  echo ""
  echo "[Nymora hook] Commit BLOQUE : violations de determinisme Quantum detectees."
  echo ""
  printf "%b\n" "$violations"
  echo ""
  echo "Le code de SIMULATION doit etre 100% deterministe (Photon Quantum)."
  echo "Paths scannes :"
  echo "  - Assets/QuantumUser/Simulation/ (sauf Generated/)"
  echo "  - Assets/_Nymora/Scripts/Combat/ (sauf View/ et Replay/ qui sont cote Unity)"
  echo ""
  echo "Interdits :"
  echo "  - Random.Range / UnityEngine.Random  -> utiliser f.RNG (Quantum)"
  echo "  - Time.time / Time.deltaTime / Time.fixedDeltaTime  -> f.DeltaTime (Quantum)"
  echo "  - DateTime.Now / DateTime.UtcNow  -> n'a pas sa place dans la simulation"
  echo ""
  echo "Pour bypasser temporairement (a tes risques) : git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
