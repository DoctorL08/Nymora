// Combatant Nymora — 1 entity Quantum par personnage en jeu.
//
// Stats Bible V7.1 (1500 HP / 8 PA / 3 PM, Colossar a 2 PM).
// Position discrete grille (GridX, GridY) — pas de Transform2D FP, on reste
// pur grid-based pour aligner avec GridSingleton et garder la simulation
// strictement entiere (deterministe trivialement, simple a debugger).
//
// PlayerIndex : 0 ou 1 en 2.2 (1v1). Plus tard 0..5 pour les modes 2v2/3v3.
//
// NymoraClass est duplique vs l'enum cote Nymora.Core.Enums : le DSL Quantum
// ne peut pas referencer un type externe. Les valeurs sont identiques (None=0,
// Soulrender=1, Nightseer=2, Colossar=3, Necram=4, Ghostra=5) — ordre verrouille
// par CombatRulesVersion, ne PAS reorganiser.

enum NymoraClass : Byte
{
    None = 0,
    Soulrender = 1,
    Nightseer = 2,
    Colossar = 3,
    Necram = 4,
    Ghostra = 5,
}

// 2.14 — Marques Nightseer applicables a un combattant (Bible V7.1 — passif "L'Œil qui n'est pas").
//   Une cible ne peut avoir qu'1 marque active a la fois (Bible : "AUCUNE marque ne s'empile").
//   Voile (= MARQUE VOILÉ) n'est PAS dans cet enum : Voile s'applique sur une CASE, pas une unite
//   (cf TileVeiledByPlayer dans Grid.qtn).
//   Verrouille : ne PAS reorganiser (CombatRulesVersion).
enum MarkKind : Byte
{
    None       = 0,
    Traque     = 1,  // Marque du Chasseur : +30% pierce shields des sorts Nightseer sur cette cible
    Empreinte  = 2,  // Empreinte : sillage visible 1 tour pour le Nightseer apres deplacement de la cible
}

component Combatant
{
    Int32 PlayerIndex;
    NymoraClass Class;

    // Stats Bible V7.1 — caps fixes par classe, valeurs courantes mutables.
    Int32 HP;
    Int32 MaxHP;
    Int32 PA;
    Int32 MaxPA;
    Int32 PM;
    Int32 MaxPM;

    // Position discrete sur la grille de combat.
    Int32 GridX;
    Int32 GridY;

    // Ressource de classe (Bible V7.1 — chaque classe en a une asymetrique) :
    //   - Soulrender : Hemoglyph (cap 5)
    //   - Nightseer  : Prescience (cap 4) — Phase 2.13
    //   - Colossar   : Fondation (cap 3) — Phase 3
    //   - Necram     : Putrefaction (cap 6) — Phase 3
    //   - Ghostra    : Remanence (3 leurres max) — Phase 3
    // En 2.9 seul Hemoglyph est implemente. Le champ Resource est generique
    // pour pouvoir accueillir toutes les classes sans refactor majeur.
    Int32 Resource;
    Int32 LastResourceGainOnHitTurn;

    // 2.10.a — Statuses (buffs / debuffs temporises). 8 slots fixes.
    // Slot libre = Kind == None. Cf StatusHelper pour les acces.
    array<Status>[8] Statuses;

    // 2.10.a — Bitfield des sorts "1 fois par match" deja utilises par CE combattant.
    //   Bit 0 = Pacte de Sang (SpellId.SoulrenderPacteDeSang)
    //   Bit 1 = Dernier Souffle (SpellId.SoulrenderDernierSouffle) — reserve 2.10.b
    //   Bits 2-31 reserves pour futurs sorts 1/match (Phase 2.13+, Phase 3)
    // Pas reset entre tours (par definition once-per-match). Reset uniquement au spawn.
    Int32 OncePerMatchUsedFlags;

    // 2.10.c — PA bonus ajoute au reset PA du PROCHAIN tour de ce combattant (Curee kill chain).
    // Reset a 0 dans TurnSystem.EnterTurnStart apres application. Pas un Status (parce que
    // l'effet est consume en 1 application precise, pas une duree).
    Int32 BonusPANextTurn;

    // 2.11 — Tour ou ce combattant a utilise Ame Laceree (signature) la derniere fois.
    // Cooldown 4 tours. Initial : -1000 (pas de cooldown au spawn).
    // Detonation Sanglante avec 5 HG total set aussi ce champ (interdit Ame Laceree + reset cooldown).
    Int32 LastAmeLaceeUsedOnTurn;

    // 2.12.bis — Tracking du dernier cast (View pole la diff pour trigger les anims cast/attack).
    // LastCastOnTurn : tour du dernier cast (init -1, increment a chaque cast reussi).
    // LastCastSpellId : SpellId du dernier cast (init None). La View map SpellId -> SpellCategory
    // pour choisir l'anim (Survival/Tactical/Offensive/Signature) et discriminer Cast vs Attack
    // selon RangeMax (melee = Attack, range = Cast).
    Int32 LastCastOnTurn;
    SpellId LastCastSpellId;

    // 2.13.e — Position cible du dernier cast (case visee). Utilisee par CombatVFXView pour
    // afficher les VFX one-shot a la position du target (et non du caster). Pour les sorts
    // self-target c'est = caster pos (cf CombatInputController qui redirige Filter=Self).
    Int32 LastCastTargetX;
    Int32 LastCastTargetY;

    // 2.13.e — Compteur monotone incremente a chaque cast reussi. Permet a la View de
    // detecter PLUSIEURS casts dans le meme tour (LastCastOnTurn ne suffit pas car il
    // reste egal pour tous les casts du tour courant). Init 0, jamais reset.
    Int32 LastCastSequence;

    // 2.14 — Marque Nightseer active sur ce combattant (Bible V7.1 "L'Œil qui n'est pas").
    //   CurrentMark == None : pas de marque (defaut).
    //   1 seule marque active a la fois (pas de stack — Bible explicite).
    //   MarkTurnsLeft : tours restants avant expiration (Marque du Chasseur = 3 tours typique).
    //   MarkAppliedOnTurn : tour de pose (skip-decrement convention).
    //   MarkOwnerPlayer : PlayerIndex du Nightseer qui a pose la marque (utile pour les
    //     interactions futures — bonus appliques uniquement au caster proprietaire).
    MarkKind CurrentMark;
    Int32 MarkTurnsLeft;
    Int32 MarkAppliedOnTurn;
    Int32 MarkOwnerPlayer;

    // 2.15.a — Compteur de degats directs subis pendant le round courant.
    //   Bible Prescience : +1 PR si Nightseer N'A PAS pris de degats ce round, -1 PR sinon.
    //   Reset a 0 au debut du 1er sous-tour de chaque round (cf TurnSystem.EnterTurnStart).
    //   Increment dans le damage loop SpellSystem (a chaque hit qui passe sur HP).
    //   Le check Prescience se fait en fin de round (TurnSystem.EnterTurnEnd dernier sous-tour).
    Int32 DamageTakenThisRound;

    // 2.15.c — Tour ou un piege POSE par ce combattant a ete declenche pour la derniere fois.
    //   Set par FogHelpers.TryTriggerTrapOnEnter (le owner du trap, pas l'enterer).
    //   Sert au bonus heal Seve Sauvage : +60 si declenchement >= currentTurn - 1 (ce round
    //   ou round precedent). Init -1000 au spawn (= jamais).
    Int32 LastTrapTriggeredOnTurn;

    // 2.16 — Tour ou ce combattant (Nightseer) a utilise Traquenard la derniere fois.
    //   Cooldown 4 tours apres usage (Bible V7.1). Initial : -1000 (pas de cooldown au spawn).
    Int32 LastTraquenardUsedOnTurn;
}
