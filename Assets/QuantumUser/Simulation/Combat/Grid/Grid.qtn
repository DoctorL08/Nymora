// Grille de combat Nymora — 10x10 cases (POLISH-5e 17 mai, etait 15x17).
// Tile : data d'une case (walkable + occupant entity + terrain).
// GridSingleton : singleton Quantum qui stocke les 100 tiles + dimensions.
//
// Width et Height sont stockes dans la singleton pour eviter les valeurs magiques
// cote runtime, mais la taille du fixed array (100) est verrouillee au compile time.
// Toute modification de la taille de grille => regenerer ce DSL + bump CombatRulesVersion.

// 2.10.c — Terrains poses par les sorts Soulrender (et futures classes).
// Verrouille : ne PAS reorganiser les ints existants (CombatRulesVersion).
enum TerrainKind : Byte
{
    None         = 0,
    VapeurCarmin = 1,  // Soulrender (Charge Brutale, classe transforme map) : -1 PM en traversee, 1 tour
    SangCoagule  = 2,  // Soulrender (Detonation Sanglante, signature Ame Laceree, passif <20% HP) : 30 dgts debut de tour, 2 tours
    BrumeToxique = 3,  // Necram (3.5.a.iii Brume Toxique) : zone DoT 3x3 2 tours. Pose : 60 dgts +1 marque unite dans zone. Entree : 30 dgts +1 marque. Fin de tour dans zone : +1 marque.
}

// 2.14 — Pieges deposes sur cases par le Nightseer (Bible V7.1).
//   FiletRonces : pose par Filet de Ronces ou Volee d'Epines : 100 dgts -2 PM + EMPREINTE 2 tours.
//   Mine        : pose par Champ de Mines (3 mines 3x3) : 70 dgts + EMPREINTE.
// Verrouille : ne PAS reorganiser (CombatRulesVersion).
enum TrapKind : Byte
{
    None        = 0,
    FiletRonces = 1,
    Mine        = 2,
    Bondissant  = 3,  // Refonte 29 mai — Piège Bondissant : éjecte l'ennemi dans la direction
                      //   choisie à la pose (FogTile.TrapDir). Pas de dégâts directs (catapulte).
}

struct Tile {
    Byte Walkable;
    EntityRef Occupant;

    // 2.10.c — Terrain temporaire pose sur la case.
    //   Terrain == None : pas de terrain (defaut).
    //   TerrainTurnsLeft : nombre de tours restants avant expiration.
    //   TerrainAppliedOnTurn : tour ou le terrain a ete pose (skip-decrement comme Statuses).
    TerrainKind Terrain;
    Int32 TerrainTurnsLeft;
    Int32 TerrainAppliedOnTurn;
}

// IMPORTANT — NE PAS ajouter de nouveaux fields sur Tile : la struct est deja proche de
// la limite Quantum (~10k bytes pour la GridSingleton avec 255 tiles fixed array).
// 2.14 : le brouillard de guerre Nightseer (Voile + Pieges) vit dans un singleton SEPARE
// (FogSingleton, cf Combat/Fog/Fog.qtn) pour eviter de gonfler GridSingleton.

singleton component GridSingleton {
    // 5.4 — Width/Height = dimensions LOGIQUES de la map courante (1v1 10x10, 2v2 12x12, 3v3 15x15),
    //   posées par GridSystem.OnInit. La View se centre dessus. Le tableau Tiles est dimensionné au
    //   MAX (15x15 = 225, cf GridConstants) ; l'index reste y*GridConstants.Width + x (stride 15).
    Int32 Width;
    Int32 Height;
    array<Tile>[225] Tiles;
}
