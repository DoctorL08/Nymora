// Systeme de tour Nymora — Bible V7.1
//
// Tour de 15 secondes, alternance stricte des joueurs, tirage d'initiative au tour 1.
// FSM : PreMatch -> TurnStart -> TurnActive -> TurnEnd -> (TurnStart suivant | MatchEnd)
//
// TurnTimerTicks est stocke en INT (pas FP) pour rester pur deterministe trivialement.
// Conversion ticks -> secondes via frame.UpdateRate (60 par defaut Quantum 3).

enum CombatPhase : Byte
{
    PreMatch = 0,
    TurnStart = 1,
    TurnActive = 2,
    TurnEnd = 3,
    MatchEnd = 4,
}

singleton component CombatState
{
    CombatPhase CurrentPhase;
    Int32 ActivePlayerIndex;

    // 2.14 — TurnNumber = numero de ROUND COMPLET (semantique Dofus). Un round =
    // tous les joueurs jouent une fois (en 1v1 : P0 puis P1 = 1 round).
    // Incremente UNIQUEMENT au debut du 1er sous-tour d'un round (cf TurnSystem.EnterTurnStart).
    Int32 TurnNumber;
    Int32 TurnTimerTicks;

    // 2.14 — Index du sous-tour DANS le round courant (0..PlayerCount-1).
    //   En 1v1 : 0 = 1er joueur du round joue, 1 = 2e joueur joue, puis retour a 0 pour le
    //   round suivant.
    //   Sert a determiner quand declencher la decrementation des statuses/marques/voiles/terrains
    //   (= UNIQUEMENT a la fin du dernier sous-tour du round, pas a chaque swap de joueur).
    Int32 SubTurnInRound;

    // 2.16.c.i — Index du joueur vainqueur (-1 si match en cours ou double KO).
    //   Mis a jour par TurnSystem.EnterTurnEnd quand un combattant atteint HP=0.
    //   La View pole ce champ + CombatPhase == MatchEnd pour afficher Victory/Defeat.
    Int32 WinnerPlayerIndex;
}
