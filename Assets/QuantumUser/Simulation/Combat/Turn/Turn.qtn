// Systeme de tour Nymora — Bible V7.1
//
// Tour de 15 secondes, alternance stricte des joueurs, tirage d'initiative au tour 1.
// FSM : PreMatch -> TurnStart -> TurnActive -> TurnEnd -> (TurnStart suivant | MatchEnd)
//
// TurnTimerTicks est stocke en INT (pas FP) pour rester pur deterministe trivialement.
// Conversion ticks -> secondes via frame.UpdateRate (60 par defaut Quantum 3).

enum CombatPhase : Byte
{
    PreMatch = 0,
    TurnStart = 1,
    TurnActive = 2,
    TurnEnd = 3,
    MatchEnd = 4,
}

singleton component CombatState
{
    CombatPhase CurrentPhase;
    Int32 ActivePlayerIndex;

    // 2.14 — TurnNumber = numero de ROUND COMPLET (semantique Dofus). Un round =
    // tous les joueurs jouent une fois (en 1v1 : P0 puis P1 = 1 round).
    // Incremente UNIQUEMENT au debut du 1er sous-tour d'un round (cf TurnSystem.EnterTurnStart).
    Int32 TurnNumber;
    Int32 TurnTimerTicks;

    // 2.14 — Index du sous-tour DANS le round courant (0..PlayerCount-1).
    //   En 1v1 : 0 = 1er joueur du round joue, 1 = 2e joueur joue, puis retour a 0 pour le
    //   round suivant.
    //   Sert a determiner quand declencher la decrementation des statuses/marques/voiles/terrains
    //   (= UNIQUEMENT a la fin du dernier sous-tour du round, pas a chaque swap de joueur).
    Int32 SubTurnInRound;

    // 2.16.c.i — Index du joueur vainqueur (-1 si match en cours ou double KO).
    //   Mis a jour par TurnSystem.EnterTurnEnd quand un combattant atteint HP=0.
    //   La View pole ce champ + CombatPhase == MatchEnd pour afficher Victory/Defeat.
    //   En 2v2/3v3 : = un membre vivant (representant) de l'equipe gagnante. Pour la
    //   discrimination Victoire/Defaite cote View en mode equipe, preferer WinnerTeamId.
    Int32 WinnerPlayerIndex;

    // 5.1 (2v2/3v3) — EQUIPE gagnante (-1 si match en cours ou draw double-KO). La fin de
    //   match se decide desormais "derniere EQUIPE debout" (et non dernier joueur). En 1v1 :
    //   WinnerTeamId == WinnerPlayerIndex (team == slot). La View mode equipe compare ce champ
    //   au TeamId du joueur local pour afficher Victoire/Defaite.
    Int32 WinnerTeamId;

    // 4.14.b (Phase 4 PvP casu) — Flag mode IA vs PvP.
    //   1 = 30_CombatIA (entrainement vs bot) -> AISystem.Update agit
    //   0 = 33_CombatCasual / futurs ranked PvP -> AISystem early-out
    // Int32 (pas Bool, primitive non-supportee par Quantum .qtn — cf pattern
    // OncePerMatchUsedFlags Combatant.qtn ligne 87). Set dans TurnSystem.OnInit
    // depuis f.RuntimeConfig.IsBotMatch. Default 0 = pvp (safe pour Phase 6).
    Int32 IsBotMatch;

    // 5.2 (2v2/3v3) — Nombre de joueurs RÉELS du combat (2 / 4 / 6). Pilote la LONGUEUR DU ROUND
    //   (nb de sous-tours) et la rotation. Posé depuis RuntimeConfig.PlayerCount à l'OnInit
    //   (fallback 2 = 1v1), puis confirmé au build de TurnOrder une fois tous les Combatants spawnés.
    Int32 PlayerCount;

    // 5.2 — ORDRE DE JEU du round = séquence de PlayerIndex (taille = PlayerCount). Alternance
    //   stricte entre équipes : [équipeA rang0, équipeB rang0, équipeA rang1, équipeB rang1, ...].
    //   L'ordre INTRA-équipe vient du vote du capitaine (RuntimePlayer.TeamOrder ; défaut = PlayerIndex).
    //   ActivePlayerIndex = TurnOrder[SubTurnInRound]. Construit une seule fois (TurnOrderBuilt).
    array<Int32>[6] TurnOrder;

    // 5.2 — Équipe qui commence le round 1 (initiative). Tirée à l'OnInit (RNG, comme avant en 1v1 ;
    //   IA -> 0 = équipe du joueur). Utilisée au build de TurnOrder (interleave). En 1v1 StartingTeam
    //   == l'ancien ActivePlayerIndex tiré -> parité déterministe exacte avec l'historique.
    Int32 StartingTeam;

    // 5.2 — 0 tant que TurnOrder n'est pas construit (tous les Combatants pas encore spawnés —
    //   OnPlayerAdded est séquentiel). 1 une fois l'ordre figé. La FSM de tour attend ce flag.
    Int32 TurnOrderBuilt;
}
