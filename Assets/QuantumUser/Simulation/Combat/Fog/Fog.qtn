// 2.14 — Brouillard de guerre Nightseer (state per-tile separe de GridSingleton).
//
// Raison du singleton separe : ajouter les fields Voile + Trap directement dans Tile
// faisait exploser la GridSingleton au-dela de la limite Quantum (~10kB) pour les
// structs passees par valeur (cf InvalidProgramException "Passing an argument of size 10208").
//
// FogSingleton mirror la grille (array<FogTile>[100] indexes par y*Width+x, meme convention
// que GridHelpers.Index). Lookups via FogHelpers. POLISH-5e (17 mai) : 255 -> 100 (10x10).
//
// Les enums TrapKind / MarkKind sont definis dans Grid.qtn / Combatant.qtn respectivement
// (proches de leurs structs cibles).

struct FogTile {
    // Voile (MARQUE VOILÉ Bible V7.1 — case invisible pour l'adversaire).
    //   VeiledByPlayer : 0 = aucun voile, sinon (PlayerIndex + 1). Le +1 pour distinguer 0=none.
    //   VeiledTurnsLeft : tours restants avant expiration.
    //   VeiledAppliedOnTurn : tour de pose (skip-decrement convention).
    Byte VeiledByPlayer;
    Int32 VeiledTurnsLeft;
    Int32 VeiledAppliedOnTurn;

    // Piege (Filet de Ronces, Mine — Bible V7.1 Nightseer).
    //   Trap == None : pas de piege.
    //   TrapOwner : PlayerIndex du poseur (declenche uniquement quand un adversaire entre).
    //   TrapAppliedOnTurn : info de pose ; pas de timer d'expiration (Bible : reste jusqu'au
    //     declenchement ou retire par Cauterisation 2.15+).
    TrapKind Trap;
    Int32 TrapOwner;
    Int32 TrapAppliedOnTurn;

    // Refonte 29 mai — Piège Bondissant : direction d'éjection choisie à la pose. Encodage
    //   cardinal : 0 = aucune (pièges normaux), 1 = +X, 2 = -X, 3 = +Y, 4 = -Y.
    Byte TrapDir;

    // #23 (5 juin) — Propriétaire du TERRAIN posé sur la case (Vapeur Carmin / Sang Coagulé /
    //   Brume Toxique). 0 = aucun owner connu, sinon (PlayerIndex + 1) — même convention que
    //   VeiledByPlayer. Sert UNIQUEMENT à l'affichage (outline d'équipe en match miroir), la sim
    //   ne s'en sert pas. Stocké ici (singleton séparé) car Tile est proche de la limite Quantum.
    Byte TerrainOwner;
}

singleton component FogSingleton {
    array<FogTile>[225] Tiles; // 5.4 : MAX 15x15 (stride GridConstants.Width=15), même convention d'index que GridSingleton
}
