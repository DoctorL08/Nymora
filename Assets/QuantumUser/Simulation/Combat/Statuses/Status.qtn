// Systeme de statuses Nymora (buffs / debuffs temporises) — Bible V7.1.
//
// Un Combatant porte jusqu'a STATUS_SLOTS statuses simultanes via array<Status>.
// Chaque status a une duree exprimee en TOURS, decrementee a TurnEnd.
//
// La regle "AppliedOnTurn" permet de skipper la decrementation au tour ou le
// status vient d'etre pose. Cela donne une semantic intuitive pour les buffs
// reactifs (Riposte Carmin) et les durees Bible V7.1 ("2 tours" = 2 tours actifs
// effectifs cote owner).
//
// StatusKind : extensible. Les valeurs sont verrouillees comme contrat avec
// CombatRulesVersion — ne PAS reorganiser les ints existants.

enum StatusKind : Byte
{
    None = 0,

    // Soulrender (2.10.a)
    AntiHealShield               = 1,  // bloque heal/shield recu (Ouvre-Plaie + 1 HG)
    AntiTeleport                 = 2,  // bloque teleport prochain tour (Rugissement, Empoignade)
    BuffNextOffensiveDmgPercent  = 3,  // Magnitude = % multiplier (Pacte de Sang = 50)
    RipostMelee                  = 4,  // Magnitude = dgts reflect (Riposte Carmin = 100)
    MovementMalus                = 5,  // Magnitude = -PM (Rugissement -1, ou -2 si HP<50%)
    RageInsatiableActive         = 6,  // Magnitude = LastTurnPAGained tracker (init -1)

    // Soulrender (2.10.b)
    MarkedByCarnage              = 7,  // cible marquee, +1 HG bonus sur cast Soulrender (3 tours)
    ShieldActive                 = 8,  // Magnitude = HP courant du shield (Peau de Fer = 200, 2 tours)
                                       //   Absorption avant HP dans damage loop. Si Magnitude tombe a 0 -> Consume.
                                       //   Pendant que actif : +30 dgts sorts melee du porteur.
    BleedDoT                     = 9,  // stub 2.10.b : DoT generique sur soi (Necram poison Phase 3, etc).
                                       //   Sert au bonus Seve Vive "saigne actuellement" (+50 HP).
                                       //   Aucun sort ne l'applique en 2.10.b (reserve pour Phase 3 Necram).

    // Nightseer (2.15.c)
    Untargetable                 = 10, // Voile d'Ombre : sorts directs (filter Enemy/AnyUnit) rejetes
                                       //   sur le porteur. AoE qui passent par la case continuent
                                       //   de toucher (Bible : invisibilite directe, pas immortalite).
    RoncesAura                   = 11, // Camouflage Ronces : Magnitude = dgts inflige aux ennemis
                                       //   adjacents (Manhattan 1) en fin de chaque round actif.
                                       //   Tick dans TurnSystem.EnterTurnEnd avant le check Prescience.

    // Nightseer (2.16) — Signature Traquenard
    ActionMalus                  = 12, // Magnitude = -PA applique au reset PA prochain tour de la cible.
                                       //   Compose la PARALYSIE Traquenard avec MovementMalus -3 PM.
                                       //   Hook dans TurnSystem.EnterTurnStart apres le reset PA + bonus.

    // Colossar (3.3.b.ii)
    AnchorImmune                 = 13, // Ancrage : Magnitude = % de reduction dmg subis (Bible 50).
                                       //   Hook 1 : PushAndTriggerEx -> push annule sur cible AnchorImmune.
                                       //   Hook 2 : Empoignade -> pull annule sur cible AnchorImmune.
                                       //   Hook 3 : damage compute -> dmg recus * (100 - Magnitude) / 100.
                                       //   Self-teleport (Pas Furtif/Evanescence) reste possible (Bible : maitre de ses propres sorts).
    Provoked                     = 14, // Provocation : Magnitude = PlayerIndex du provocateur (caster).
                                       //   Stub MVP : status apply + duree decrement OK. Effet IA (force
                                       //   l'attaque vers le provocateur) sera branche en 3.8 IA Hard.

    // Colossar (3.3.c — Survie)
    DamageReductionPercent       = 15, // Garde Protectrice : Magnitude = % reduction dgts subis (Bible 30).
                                       //   S'additionne avec Densite Inerte mais clampe a 50% total (Bible
                                       //   "Ne se cumule pas au-dela du cap -50%"). Bypass DoT venin Necram
                                       //   (TODO Phase 3.4). Cf ColossarPassif.GetCombinedDamageReductionPercent.
    RipostAll                    = 16, // Renvoi du Bouclier : Magnitude = dgts reflect TOUTE attaque
                                       //   (melee + distance), pas que melee comme RipostMelee. Cap 4 retours
                                       //   stocke dans Combatant.RepresaillesReflectsLeft (reuse). Bible 60 dgts.

    // Colossar (3.3.d — Signature Effondrement)
    EffondrementActive           = 17, // Effondrement (Bible V7.1) : buff 2 tours pendant lequel le Colossar
                                       //   gagne +1 PM (TurnSystem.EnterTurnStart), ses sorts coutent -1 PA
                                       //   (EffectiveStats.GetPACost), et -30% dgts subis (via Status
                                       //   DamageReductionPercent applique en parallele avec cap combine 50%).
                                       //   Magnitude unused (0). Pose au TRIGGER (pas au cast), apres l'annonce.

    // Necram (3.5.b.i — Tactiques)
    MarqueSacrificielle          = 18, // Bible V7.1 : Magnitude = bonus dmg flat par tick venin sur le porteur
                                       //   (20 fixe). Duree 3 rounds. Hook dans VeninHelpers.TryTick :
                                       //   totalDmg += Magnitude si actif. S'applique meme si pas de marques
                                       //   actives au cast (Bible "effet neutre" sans marques, le bonus
                                       //   declenchera des qu'une marque sera posee).

    // Necram (3.5.b.ii — Tactiques)
    SymbioseMorbide              = 19, // Bible V7.1 : self-buff lifesteal DoT. Magnitude = heal par marque
                                       //   par tick (8 fixe). Duree 2 rounds. Hook dans VeninHelpers.TryTick :
                                       //   tout Necram vivant porteur du status est soigne de
                                       //   min(target.VeninStacks, 4) * Magnitude HP a chaque tick venin sur
                                       //   un ennemi (max +32 HP/tick, +64 sur 2 rounds avec 4 marques).

    // Necram — refonte 29 mai
    Contagious                   = 32, // Contagion (refonte) : posé sur un ENNEMI 2 rounds. Magnitude
                                       //   inutilisée (0). Hook TurnSystem.EnterTurnEnd : à la fin du
                                       //   sub-turn du porteur, +1 marque venin AUTO sur lui-même
                                       //   (auto-propagation). Skip si DotImmune.

    VeninDecay                   = 33, // Minuteur d'expiration des marques de venin (patch 5 juin : « les
                                       //   poisons durent 2 tours max »). Magnitude inutilisée (0). (RE)posé
                                       //   à VeninHelpers.VeninDurationTurns rounds à CHAQUE application de
                                       //   venin (refresh). Quand il expire (DecrementAllOnTurnEnd), le hook
                                       //   VeninHelpers.ClearExpiredVenin (fin de round, après décrément) vide
                                       //   les VeninStacks du porteur. Avant ce patch, les marques ne
                                       //   expiraient JAMAIS par durée (consommation only). N'affecte pas le
                                       //   layout (enum Byte) -> codegen Quantum + rebuild, pas de régén prefab/scène.

    // Necram (3.5.c.i) — refonte 29 mai : ex-Voile de Pestilence, désormais NUÉE DE SPORES.
    PestilenceAura               = 21, // Refonte : buff self du Necram 2 rounds (Nuée de Spores).
                                       //   Magnitude inutilisée (0). Hook (SpellSystem post-cast) :
                                       //   tant qu'actif, chaque sort du Necram visant un ennemi pose
                                       //   +1 marque venin BONUS sur la cible. (Anciens hooks aura
                                       //   adjacence/riposte mêlée RETIRÉS.)
                                       // --- ancienne doc Voile de Pestilence (obsolète) ---
                                       //   Hook 1 (TurnSystem.EnterTurnEnd) : fin du sub-turn d'un ennemi a
                                       //     Manhattan <= 2 du porteur -> +1 marque venin sur l'ennemi.
                                       //   Hook 2 (SpellSystem damage loop) : si le porteur subit une ATTAQUE
                                       //     MELEE (Chebyshev caster-cible <= 1 au moment du dmg, soit 8
                                       //     voisines + soi du caster post-deplacement), +1 marque venin sur
                                       //     l'attaquant. Bible-strict : couvre Charge Brutale post-move,
                                       //     Faux Decharnee Square3x3, Tranche-Ame, etc. Rejette les sorts
                                       //     distants (Crachat range 4, Tir Precis range 4).
                                       //   Refresh-only : recast meme tour remet turnsLeft a 2 (pas de stack).

    // Necram (3.5.b.iii — Tactiques mobilite)
    PasSpectralReady             = 20, // Bible V7.1 : buff Pas Spectral. Magnitude inutilisee (0).
                                       //   Duree = sub-turn courant du porteur (consume dans
                                       //   TurnSystem.EnterTurnEnd quand ActivePlayerIndex == porteur).
                                       //   Tant que actif : AStarPathfinder recoit ignoreEnemyOccupants=true
                                       //   pour les MoveCommand du Necram, et MovementSystem.ApplyMove pose
                                       //   +1 marque venin sur chaque ennemi present sur les cases
                                       //   intermediaires du path (skip destination).

    // Necram (3.5.c.ii — Survie bouclier piege)
    // Ghostra (3.7.a.i.1) — passif Angle Mort + sorts offensifs
    PlaieOuverte                 = 23, // Bible V7.1 : DoT Ghostra applique par bonus dorsal Angle 2+ ou
                                       //   par Frappe Fantôme (target Volte-Face). Magnitude = dmg/tour
                                       //   (40 Bible). TurnsLeft = duree rounds (2 Bible). Tick dans
                                       //   TurnSystem.EnterTurnEnd : si Has(PlaieOuverte), -Magnitude HP.
                                       //   Consomme par Saigne-Âme (+70 dmg si actif, retire le status).
                                       //   Refresh-only : recast meme tour remet turnsLeft=2 et magnitude=40.

    // Ghostra
    DirectionLocked              = 24, // RESERVED (amendement 16 mai 2026) : initialement utilise par
                                       //   Volte-Face en version Bible-stricte (verrou Facing 1 round).
                                       //   Volte-Face refondu en sort offensif sans verrou (50 dmg + flip
                                       //   instantane). Status conserve dans l'enum pour ne pas reordonner
                                       //   les IDs (regen Quantum CodeGen). Plus jamais applique en
                                       //   gameplay. Reutilisable si besoin futur (ex : Frappe Fantôme,
                                       //   nouveau sort verrou direction).

    MarqueDeLOmbre               = 25, // Bible V7.1 Ghostra (3.7.b.v) : buff de pression pose par Marque
                                       //   de l'Ombre. Magnitude = bonus dmg (20). Duree 2 rounds.
                                       //   Hook 1 (SpellSystem pipeline damage) : si caster Ghostra ET
                                       //     target porte MarqueDeLOmbre -> dmg += Magnitude.
                                       //   Hook 2 (GhostraPassif.ApplyPlaieOuverteIfAngle2Plus) : si target
                                       //     porte MarqueDeLOmbre ET hit Ghostra dorsal -> apply PlaieOuverte
                                       //     AUTO (bypass requirement Angle 2+ via leurres). Permet PlaieOuverte
                                       //     a Angle 1 (sans leurre). Anti-tank par contournement Bible.
                                       //   Refresh-only : recast meme tour remet turnsLeft=2 et magnitude=20.

    CarapaceVisqueuse            = 22, // Bible V7.1 : flag bouclier piege. Magnitude inutilisee (0).
                                       //   Duree 2 rounds, applique en parallele de ShieldActive (110 HP).
                                       //   Hook (SpellSystem damage loop, apres bloc d'absorption shield) :
                                       //   si target porte CarapaceVisqueuse ET le shield a absorbe au moins
                                       //   1 dmg de l'attaque ET ATTAQUE MELEE (Chebyshev caster-cible <= 1
                                       //   au moment du dmg, soit 8 voisines + soi du caster post-deplacement)
                                       //   -> +1 marque venin sur l'attaquant (cap 4 via ApplyMark).
                                       //   Bible-strict : couvre Charge Brutale post-move, Faux Decharnee
                                       //   Square3x3, Tranche-Ame, etc. Rejette les sorts distants.
                                       //   Bible "frappe le bouclier" = condition absorbed >= 1 (le hook
                                       //   trigger meme si shield absorbe TOUT le dmg, donc HP_loss=0).
                                       //   Si shield deja brise avant l'attaque -> pas de trigger (le bouclier
                                       //   n'est plus la, l'epine ne pique plus).
                                       //   Refresh-only : recast meme tour remet turnsLeft a 2 (ShieldActive
                                       //   reset a 110 HP, CarapaceVisqueuse reset a 2 rounds).

    // Ghostra (3.7.c.ii — Survie reset DoT)
    DotImmune                    = 27, // Bible V7.1 Ghostra ligne 1166 : flag d'immunite aux applications de DoT.
                                       //   Magnitude inutilisee (0). Duree 1 round (set turnsLeft=1 + skip
                                       //   decrement au sub-turn d'application via AppliedOnTurn).
                                       //   Pose par Voile Spectral apres consume des DoT actifs (BleedDoT,
                                       //   PlaieOuverte, VeninStacks=0).
                                       //   Hooks d'interception (bloquent l'apply si porteur Has(DotImmune)) :
                                       //     - VeninHelpers.ApplyMark : skip apply marque venin.
                                       //     - GhostraPassif.ApplyPlaieOuverteIfAngle2Plus : skip apply PlaieOuverte.
                                       //     - SpellSystem.cs case Frappe Fantome (apply PlaieOuverte conditional
                                       //       Volte-Face) : skip apply.
                                       //   Bible-strict perimetre : status DoT explicites uniquement (PlaieOuverte,
                                       //   BleedDoT, VeninStacks). Le tick fin de round terrain (Sang Coagule, etc.)
                                       //   N'EST PAS bloque (continue d'agir normalement).
                                       //   Voile Spectral 1x/match (OncePerMatchBit=4) -> au plus une activation
                                       //   par combat. Pas de stack possible.

    // Ghostra (3.7.c.i — Survie bouclier epineux)
    // Ghostra (3.7.c.v — Survie mobilite anti-control)
    PasAuDelaReady               = 28, // Bible V7.1 Ghostra ligne 1180 : buff Pas de l'Au-Dela. Magnitude
                                       //   inutilisee (0). Duree = sub-turn courant du porteur (consume dans
                                       //   TurnSystem.EnterTurnEnd quand ActivePlayerIndex == porteur, pattern
                                       //   identique a PasSpectralReady Necram). Tant que actif :
                                       //   - AStarPathfinder recoit ignoreEnemyOccupants=true pour les MoveCommand
                                       //     de la Ghostra (traverse ennemis ET leurres).
                                       //   - MovementSystem.ApplyMove pose PasAuDelaDorsalDamage HP loss direct
                                       //     (60 dmg frappe dorsale gratuite Bible) sur chaque ennemi present sur
                                       //     les cases intermediaires du path (skip destination, multi-targets
                                       //     Lorenzo : TOUS les ennemis traverses prennent 60 dgts).
                                       //   - MovementRangePreview / CombatantRenderer detectent le status pour
                                       //     activer le BFS preview / anim path traversant (parite Pas Spectral).
                                       //   Pas de consume au move : le status reste actif pour tout le tour Ghostra
                                       //   (multi-moves benefice du bypass, coherent avec "+2 PM ce tour" Bible).

    // Soulrender (refonte 29 mai)
    HealReductionPercent         = 29, // Ouvre-Plaie 1 HG : Magnitude = % de reduction des soins ET
                                       //   des boucliers RECUS par le porteur (50 = ÷2). Duree 1 tour
                                       //   (skip-decrement au tour d'application). Hooks : HealHelper.ApplyHeal
                                       //   (reduit le heal) + HealHelper.EffectiveShieldGain (reduit le shield
                                       //   pose). Remplace l'AntiHealShield d'Ouvre-Plaie (qui bloquait tout).
    SangBouillantActive          = 30, // Sang Bouillant (ex-Cautérisation) : flag 2 rounds. Magnitude
                                       //   inutilisee (0). Hook (SpellSystem damage loop, cote VICTIME) :
                                       //   quand le porteur SUBIT des degats -> +1 HG (cap) + applique
                                       //   NextStrikeBonus (prochaine frappe +30). Refresh-only.
    NextStrikeBonus              = 31, // Magnitude = bonus de degats FLAT sur la prochaine frappe offensive
                                       //   du porteur (Sang Bouillant = 30). Consomme apres application sur
                                       //   le 1er sort offensif qui inflige des degats. Refresh (pas de stack).

    AffutActive                  = 34, // Affut (patch 7 juin, ex-Marque du Chasseur Nightseer) : self-buff.
                                       //   Magnitude = % bonus dgts (10). Duree 2 rounds. Hooks :
                                       //   - cast validation (SpellSystem) : +AffutRangeBonus (2) portee
                                       //     sur les sorts a distance (RangeMax >= 1) du porteur.
                                       //   - damage loop + ApplyOffensiveCasterBuffs + SpellPreview :
                                       //     +AffutDmgBonusPct (10)% dgts offensifs.
                                       //   Pose par Marque du Chasseur (refondue). Relance 3 tours
                                       //   (moteur generique CooldownTurns). Refresh-only.
                                       //   Enum Byte -> codegen Quantum mis a jour, PAS de regen prefab/scene.

    LinceulDOmbres               = 26, // Bible V7.1 Ghostra ligne 1173 : flag bouclier epineux Ghostra.
                                       //   Magnitude = dgts riposte (40). Duree 2 rounds, applique en
                                       //   parallele de ShieldActive (130 HP).
                                       //   Hook 1 (SpellSystem damage loop, apres hook Carapace, AVANT
                                       //     bloc HP loss) : si target porte LinceulDOmbres ET attaque
                                       //     MELEE (Chebyshev caster-cible <= 1) -> renvoie Magnitude
                                       //     dgts a l'attaquant. PIPELINE STANDARD : applique reduction%
                                       //     (Densite Inerte + Garde Protectrice cap 50%) puis shield
                                       //     attaquant. Trigger meme si shield Linceul absorbe tout (Bible
                                       //     "toute attaque melee subie").
                                       //   Hook 2 (SpellSystem.cs path custom Charge Brutale) : Charge
                                       //     Brutale bypass le pipeline standard, donc on rebranche le
                                       //     hook manuellement (caster post-move adjacent = melee implicite).
                                       //   Bible "Anti-Soulrender qui charge". Refresh-only : recast
                                       //     meme tour reset shield 130 HP + duree 2 rounds.
                                       //   Pas de -1 PM sur attaquant (cf Riposte Carmin Soulrender) :
                                       //     Bible Linceul muet sur ce point, juste "renvoie 40 dgts".
}

struct Status
{
    StatusKind Kind;
    Int32 Magnitude;
    Int32 TurnsLeft;
    Int32 AppliedOnTurn;
}
