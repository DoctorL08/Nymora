// Catalogue des sorts Nymora (Bible V7.1).
//
// SpellId : enum cle. Plages reservees :
//   0      : None
//   1-9    : Sorts de test / dev
//   10-29  : Soulrender (15 sorts + signature = 16, marge a 20)
//   30-49  : Nightseer
//   50-69  : Colossar (Phase 3)
//   70-89  : Necram (Phase 3)
//   90-109 : Ghostra (Phase 3)
//
// SpellEffectKind : tous les types d'effets possibles. En 2.10.a, Damage et
// Heal (preparation 2.10.b). Les autres seront ajoutes selon les besoins.

enum SpellId : Byte
{
    None = 0,

    TestZap = 1,
    // 2-9 reserves pour autres sorts de dev

    // SOULRENDER (Bible V7.1 — 5 offensifs + 5 tactiques + 5 survie + signature)
    SoulrenderTrancheAme        = 10,  // 2.8  — Offensif : 3 PA, melee 1, 220 dgts (+ recul 2 cases si kill, 2.10.c)
    SoulrenderOuvrePlaie        = 11,  // 2.10.a — Offensif : 2 PA, range 1, 110 dgts (+120 si 1 HG, anti-heal)
    SoulrenderChargeBrutale     = 12,  // 2.10.c — Offensif : 4 PA, ligne range 5, 180 dgts 1ere cible + Vapeur Carmin cases foulees
    SoulrenderDetonationSanglante = 13, // 2.10.c — Offensif : 4 PA, range 4 croix 3, 60 base +40 par HG (min 2, max 5), Sang Coagule centre
    SoulrenderCuree             = 14,  // 2.10.c — Offensif : 2 PA, range 2, 2 HG, 150 dgts. Kill -> heal 50% manquants + 4 PA next turn. Miss -> -60 HP self.
    SoulrenderPacteDeSang       = 15,  // 2.10.a — Tactique : 1 PA, self, -80 HP +3 HG +50% next offensif, 1/match
    SoulrenderMarqueDeCarnage   = 16,  // 2.10.b — Tactique : 2 PA, range 5, marque cible 3 tours (+1 HG bonus sur cast Soulrender)
    SoulrenderEmpoignade        = 17,  // 2.10.b — Tactique : 3 PA, range 3, pull cible adjacent + anti-teleport 1 tour
    SoulrenderRugissement       = 18,  // 2.10.a — Tactique : 3 PA, AoE rayon 3, -1 PM + anti-tp (ou -2 si <50%)
    SoulrenderRageInsatiable    = 19,  // 2.10.a — Tactique : 3 PA, self, 2 tours +1 PA cost / +1 PA regen offensif
    SoulrenderRiposteCarmin     = 20,  // 2.10.a — Survie  : 2 PA, self, 1 tour reflect 100 dgts melee + -1 PM attaquant
    SoulrenderCauterisation     = 21,  // 2.10.c — Survie  : 2 PA, self, retire tous DoT + heal 60/DoT (min 60, max 180). Stub 2.10.c (pas de DoT actuel).
    SoulrenderPeauDeFer         = 22,  // 2.10.b — Survie  : 3 PA, self, shield 200 HP / 2 tours + 30 dgts bonus melee
    SoulrenderSeveVive          = 23,  // 2.10.b — Survie  : 2 PA, self, heal 100 (+60 si 1 HG, +50 si DoT actif)
    SoulrenderDernierSouffle    = 24,  // 2.10.b — Survie  : 4 PA, self, HP<30% only, heal 200 + 3 HG, 1/match
    SoulrenderAmeLaceree        = 25,  // 2.11 — SIGNATURE : 2 PA, melee 1, 5 HG (consomme tout), 320 dgts + heal 50% dgts qui passent. Cooldown 4 tours. Kill -> Sang Coagule croix 5.

    // NIGHTSEER (Bible V7.1 — 5 offensifs + 5 tactiques + 5 survie + signature)
    NightseerTirPrecis            = 30,  // 2.15.a — Offensif : 3 PA, range 6, 200 dgts (+80 et +1 PR si target Traque)
    NightseerVoleeDEpines         = 31,  // 2.15.a — Offensif : 4 PA, ligne range 5, 130 dgts toutes cibles + Filet de Ronces sur derniere case touchee
    NightseerDetonationOnirique   = 32,  // 2.15.a — Offensif : 4 PA, range 5 (10 avec 2 PR), AoE 2x2 170 dgts (+80 et dechire si Voile dans zone)
    NightseerFrappeDeLOmbre       = 33,  // 2.15.a — Offensif : 4 PA, range 3, 200 dgts (+100 si target PM < MaxPM/2 + Empreinte 2 tours)
    NightseerSalveMortelle        = 34,  // 2.15.a — Offensif : 5 PA, range 6, AoE croix 5 (220 centre / 130 cotes), 3 PR (+60 Traque, dechire Voile +50)

    // NIGHTSEER 2.15.b — TACTIQUES
    NightseerMarqueDuChasseur     = 35,  // 1 PA, range 5, applique Traque 3 tours sur cible
    NightseerFiletDeRonces        = 36,  // 2 PA, range 4, pose Filet (Voile + Trap). Entree : 100 dgts -2 PM + Empreinte 2 tours
    NightseerChampDeMines         = 37,  // 4 PA, range 3, AoE 3x3, pose 3 Mines voilees. Chaque mine : 70 dgts + Empreinte
    NightseerBourrasque           = 38,  // 3 PA, range 5, push cible 3 cases loin du caster (5 avec 1 PR)
    NightseerSouffleGlacial       = 39,  // 3 PA, AoE croix 3 autour caster, 70 dgts + push 1 + MovementMalus -1

    // NIGHTSEER 2.15.c — SURVIE
    NightseerVoileDOmbre          = 40,  // 3 PA, self, applique Untargetable 1 round (sorts directs rejetes)
    NightseerPasFurtif            = 41,  // 2 PA, range 4, teleport sur case vide (Shift = +1 PR -> Voile 2 tours sur arrivee)
    NightseerCamouflageRonces     = 42,  // 3 PA, self, ShieldActive 130 HP / 2 tours + RoncesAura 70 dgts ennemis adjacents
    NightseerSeveSauvage          = 43,  // 3 PA, self, heal 130 (+60 si trap declenche dans ces 2 rounds, +30 si voile actif)
    NightseerEvanescence          = 44,  // 4 PA, range 7, HP<30%, teleport + heal 150 + Voile 2 tours sur case quittee, 1/match

    // NIGHTSEER 2.16 — SIGNATURE
    NightseerTraquenard           = 45,  // 2 PA, range 5, 4/4 PR, teleport adjacent + 280 dgts + Paralysie -3PM/-2PA. Bonus +80 dgts + 2 PR si target Traque/Voile/Empreinte (consume marque). Cooldown 4 tours.

    // COLOSSAR (Bible V7.1 — 5 offensifs + 5 tactiques + 5 survie + signature) — Phase 3.3.a/b/c
    ColossarFrappeLourde          = 50,  // 3.3.a.i — Offensif : 3 PA, melee 1, 180 dgts (+100 = 280 si cible epinglee)
    ColossarOndeDeChoc            = 51,  // 3.3.a.ii — Offensif AoE rayon 1 : 3 PA, 80 dgts adj + push 2 (+80 + TRAUMA si push contre obstacle/bord)
    ColossarMarteauPunisseur      = 52,  // 3.3.a.ii — Offensif anti-caster : 4 PA, range 2, 160 dgts (240 + TRAUMA -2 PA si target PA<4)
    ColossarChocSismique          = 53,  // 3.3.a.ii — Offensif ligne 4 : 4 PA, 130 dgts ligne + -1 PM cibles, traverse Pilier/Mur OWN +50 dgts next
    ColossarRepresailles          = 54,  // 3.3.a.i — Offensif/Defensif : 3 PA, melee 1, 100 dgts. 2 tours : reflect 80 dgts melee (cap 4 TODO)

    // COLOSSAR 3.3.b — TACTIQUES
    ColossarPilier                = 55,  // 3.3.b.i — Tactique : 3 PA, range 3 case vide, pose Pilier 200 HP. Reste jusqu'a destruction (pas de timer). +1 FD via SpawnObstacle hook. Bloque mouvement + LoS.
    ColossarMurDePierre           = 56,  // 3.3.b.i — Tactique : 4 PA, range 4, pose ligne 3 cases (5 avec 1 FD) Mur 150 HP/case / 2 tours. +1 FD par segment pose. Bloque mouvement + LoS.
    ColossarAncrage               = 57,  // 3.3.b.iii — Tactique anti-mobilite : 2 PA, range 4, ENEMY. -2 PM 2 tours + immune push/pull/teleport 1 tour. Pas de damage.
    ColossarProvocation           = 58,  // 3.3.b.iii — Tactique : 2 PA, range 5, ENEMY, 1 tour. -1 PM + sorts non-cible-caster coutent +2 PA. 100 dgts auto si pas adjacent caster fin tour.
    ColossarBrisure               = 59,  // 3.3.b.iii — Tactique anti-buff : 3 PA, range 2, ENEMY, 90 dgts + retire 1 buff/bouclier (priorite ShieldActive). Si pas de buff : TRAUMA -2 PA prochain tour.

    // COLOSSAR 3.3.c — SURVIE (Bible V7.1)
    ColossarStoicisme             = 60,  // 3.3.c — Survie : 3 PA, self, ShieldActive 200 HP / 2 tours + immune push/pull/tp 2 tours. Si shield Magnitude>0 a expiration : +80 HP heal.
    ColossarGardeProtectrice      = 61,  // 3.3.c — Survie : 2 PA, self, DamageReductionPercent 30% / 2 tours. Cap combine avec Densite Inerte a 50% total (additif clamp).
    ColossarRessacVital           = 62,  // 3.3.c — Survie : 2 PA, self, heal 80 + 30 par attaque subie tour precedent (max +120, cap total 200 HP).
    ColossarRenvoiDuBouclier      = 63,  // 3.3.c — Survie : 3 PA, self, RipostAll 60 dgts (melee OU distance) 1 tour. Cap 4 retours (reuse RepresaillesReflectsLeft).
    ColossarSoinLourd             = 64,  // 3.3.c — Survie : 3 PA, self (1v1 MVP, Bible : range 3 self/allie en 2v2/3v3), heal 150 HP. Unique heal cross-classe (TODO 2v2).

    // COLOSSAR 3.3.d — SIGNATURE
    ColossarEffondrement          = 65,  // 3.3.d — Signature : 4 PA, AoE rayon 2 autour caster. Coute 3/3 FD (consomme tout, reset 0). Annonce 1 tour a l'avance. Trigger au prochain sub-turn caster : 200 dgts ennemis dans rayon + ejection vers case libre + Failles 2 tours (impraticables). Buff 2 tours : +1 PM, -1 PA cost, -30% dgts subis. Cooldown 4 tours.

    // NECRAM (Bible V7.1 — 5 offensifs + 5 tactiques + 5 survie + signature) — Phase 3.5
    NecramCrachatAcide            = 70,  // 3.5.a.i — Offensif : 3 PA, range 4, 90 dgts + applique 2 marques venin (cap 4/cible). Sort de base.
    NecramMorsurePutride          = 71,  // 3.5.a.i — Offensif finisher : 4 PA, melee 1, 110 dgts + 22 par marque (max +90, total max 200). Si kill : marques transferees sur ennemi vivant le plus proche.
    NecramDetonationVirulente     = 72,  // 3.5.a.ii — Offensif burst : 4 PA, range 4, 80 dgts + 50/marque consommee (4 marques = 280 dmg). Reset VeninStacks=0 post-damage.
    NecramFauxDecharnee           = 73,  // 3.5.a.ii — Offensif AoE sustain : 4 PA, melee Square3x3 autour caster, 130 dgts par cible. Necram heal 30 HP/marque active sur cibles touchees (cap +120 = 4 marques).
    NecramBrumeToxique            = 74,  // 3.5.a.iii — Offensif zone DoT : 4 PA, range 4, AoE 3x3 / 2 tours. Pose : 60 dgts +1 marque unite dans zone. Entree : 30 dgts +1 marque. Fin de tour dans zone : +1 marque.

    // NECRAM 3.5.b — TACTIQUES
    NecramInoculation             = 75,  // 3.5.b.i — Tactique setup pur : 1 PA, range 5, applique 2 marques venin (cap 4). Pas de damage.
    NecramMarqueSacrificielle     = 76,  // 3.5.b.i — Tactique buff DoT : 2 PA, range 5, status 3 rounds. +20 dgts flat par tick venin sur la cible. Effet neutre si pas de marques actives au cast.
    NecramSymbioseMorbide         = 77,  // 3.5.b.ii — Tactique self-buff lifesteal : 3 PA, self, status 2 rounds. Necram heal +8 HP par marque par tick venin sur ennemis (max +32 HP/tick = 4 marques * 8, +64 sur 2 rounds).
    NecramContagion               = 78,  // 3.5.b.iv — Tactique propagation : 3 PA, range 5, target ennemie marquee requise. Copie min(stacks, cap) marques sur autres ennemis rayon 3 (Manhattan) de la cible. Cap 3 default, ou 4 avec 2 PT optionnel. En 1v1 (pas d'autres ennemis) : +1 marque sur la cible (boost).
    NecramPasSpectral             = 79,  // 3.5.b.iii — Tactique mobilite : 2 PA, self. +2 PM ce tour (cap si refresh) + status PasSpectralReady (sub-turn). Tant que actif : A* traverse ennemis, +1 marque venin par ennemi traverse sur cases intermediaires.

    // NECRAM 3.5.c — SURVIE
    NecramVoilePestilence         = 80,  // 3.5.c.i — Survie aura : 3 PA self, status PestilenceAura 2 rounds. Fin sub-turn ennemi a dist Manhattan <=2 du porteur -> +1 marque. Sort melee subi par le porteur -> +1 marque sur l'attaquant.
    NecramCarapaceVisqueuse       = 81,  // 3.5.c.ii — Survie bouclier piege : 3 PA self, ShieldActive 110 HP / 2 rounds + status CarapaceVisqueuse flag 2 rounds. Attaquant melee qui frappe le bouclier (shield absorbe >=1 dmg) -> +1 marque venin sur l'attaquant. Trigger meme si shield absorbe tout (HP loss=0). Pas de trigger si shield deja brise.
    NecramDrainVital              = 82,  // 3.5.c.iii — Survie heal offensif : 3 PA, range 4, 60 dgts cible. Caster Necram heal 30 HP (ou 60 HP si target.VeninStacks>=3). Marques cible NON consommees (pas de reset post-cast). Heal applique meme si target meurt sur les 60 dmg. Cap MaxHP standard.
    NecramPulseSanguinVert        = 83,  // 3.5.c.iv — Survie heal zone : 3 PA self, no dmg. Necram heal 70 HP + 15 HP par marque venin somme sur tous les ennemis vivants Manhattan <=4 (cap bonus +90 HP = 6 marques). Avec 1 PT optionnel (Shift+X) : +30 HP additionnel. Marques NON consommees. Cap MaxHP standard.
    NecramCoconPutride            = 84,  // 3.5.c.v — Survie panic signature : 4 PA self, gate HP <30% requis, 1x/match. Necram heal 220 HP (cap MaxHP) + +1 marque venin sur tous ennemis vivants Manhattan <=4 du caster. Bible "L'explosion fongique : le Necram a l'agonie devient soudain le Necram avec 6+ marques sur la map".

    // NECRAM SIGNATURE — VIRUS FATAL (Bible V7.1 lignes 855-866)
    NecramVirusFatal              = 85,  // 3.5.c.vi — SIGNATURE : 2 PA, range 5, 6/6 PT (consomme tout). Tick venin instantane * 3 sur cible (stacks * GetTickDmgPerMark(densityGlobal) * 3 + MarqueSac * 3). Bypass shield/reduction. Symbiose Morbide hook heal *3. Si cible survit : marques consommees. Si cible meurt : marques transferees sur ennemi vivant le plus proche (TryTransferVeninOnKill, 1v1 = perdues). Cooldown 4 tours apres usage. Re-castable si PT remonte a 6 ET cooldown expire.

    // GHOSTRA (Bible V7.1 — 5 offensifs + 5 tactiques + 5 survie + signature) — Phase 3.7
    GhostraLameSpectrale          = 86,  // 3.7.a.i.2 — Offensif base : 3 PA, melee 1, 170 dgts + bonus dorsal (0/+50/+80 selon Angle Mort) + 60 si target a Plaie Ouverte.
    GhostraLameVoraceSpectrale    = 87,  // 3.7.a.i.2 — Offensif combo bleed : 3 PA, melee 1, 130 dgts + 60 si target a Plaie Ouverte (NON consommee) + bonus dorsal.
    GhostraRepliqueFantome        = 88,  // 3.7.b.i — Tactique creation leurre : 3 PA, range 4 case vide, pose DecoyKind.RepliqueFantome (clone visuel identique, dure DecoyHelpers.LifetimeRounds = 4 rounds amendement 16 mai). Heal owner +80 HP si survit la duree complete, +40 HP si detruit prematurement. Compte dans le cap 3 leurres.
    GhostraPasDansLOmbre          = 89,  // 3.7.b.ii — Tactique mobilite : 2 PA, range 5 case vide (teleport). Toute cible ennemie adjacente a l'arrivee PIVOTE face a la Ghostra. Optionnel (Shift+H = HGSpend 1) : pose DecoyKind.Standard sur case quittee (compte dans cap 3, refus silencieux si cap atteint).
    GhostraVolteFace              = 90,  // 3.7.b.iii (amendement 16 mai) — Offensif mindgame : 2 PA, range 4 ENEMY. **80 dgts** (bump balance 50->80, 2x Dague Lancee 1 PA 40 dmg) + bonus dorsal Angle Mort si applicable + flip Facing cible 180° instantane (FacingHelpers.Opposite). PAS DE VERROU : cible se reoriente normalement a son prochain tour (walk/cast/push pivots standard).
    GhostraSaigneAme              = 91,  // 3.7.a.ii — Offensif finisher PlaieOuverte : 4 PA, range 2 ENEMY, 200 dgts base + 70 si target a PlaieOuverte (consomme la plaie sur cible vivante) + bonus dorsal. Si kill : Ghostra heal +60 HP. Aboutissement combo Bible "Plaie Ouverte -> Lame Vorace xN -> Saigne-Ame".
    GhostraFrappeFantome          = 92,  // 3.7.a.iii — Offensif engage burst : 4 PA, range 4 ENEMY. Teleport Ghostra sur case libre adjacente target + 200 dgts (+ bonus dorsal Angle Mort). Si target.LastFacingForcedOnTurn == currentTurn (Volte-Face / direction forcee ce tour) -> applique PlaieOuverte (40/tour x 2t). Bible "Combinee a Volte-Face : combo shred 350+ HP en 1 tour".
    GhostraDagueLancee            = 93,  // 3.7.b.iv (amendement 16 mai) — Tactique harcelement : 1 PA, range 5 ENEMY, cap 2x/tour. **40 dgts** (nerf balance 80->40, 1/2 Volte-Face 2 PA 80 dmg) + bonus dorsal + pivot target 90° HORAIRE iso + flag LastFacingForcedOnTurn (combo Dague->Frappe Fantome = PlaieOuverte). Bible "Le caillou dans la vitre — manipule le regard".
    GhostraMarqueDeLOmbre         = 94,  // 3.7.b.v — Tactique buff pression : 2 PA, range 4 ENEMY. Aucun damage. Applique status MarqueDeLOmbre 2 rounds magnitude=20. Hook 1 : tous les sorts Ghostra sur cette cible +20 dmg pendant la duree. Hook 2 : tout hit dorsal Ghostra sur cible marquee -> PlaieOuverte AUTO (bypass requirement Angle 2+ leurres). Bible "Le sceau — anti-tank par contournement".
    GhostraDanseDesLames          = 95,  // 3.7.a.iv — Offensif burst AoE (Bible V7.1 ligne 1116) : 5 PA, range 0 (Self), AoE Square3x3 = 8 cases adjacentes au caster (centre exclu via filtre caster auto). 180 dgts par cible ennemie touchee + bonus dorsal Angle Mort generique (0/+50/+80) + bonus Marque de l'Ombre +20 + PlaieOuverte auto sur dorsal Angle 2+. Pas de consommation de leurre (interpretation Lorenzo 16 mai : on garde la condition naturelle dorsal uniquement, l'option Bible est zappee). Bible "L'apocalypse en miniature".
}

enum SpellEffectKind : Byte
{
    None = 0,
    Damage = 1,
    Heal = 2,
    ApplyMark = 10,
    Push = 20,
    Pull = 21,
    Spawn = 30,
}
