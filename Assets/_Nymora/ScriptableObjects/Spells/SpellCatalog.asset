    CombatRulesVersion: 74
  - SpellId: soulrender_riposte_carmin
    DisplayName: Riposte Carmin
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: 7c8fe6cd38b1ad04cb06803076bf9dcd, type: 3}
    Description: "Pendant 1 tour, toute attaque M\xCAL\xC9E subie par le Soulrender
      renvoie 100 d\xE9g\xE2ts \xE0 l'attaquant ET lui co\xFBte 1 PM additionnel
      pour son prochain mouvement. Le Soulrender prend les d\xE9g\xE2ts normalement."
    LoreFlavor: "Le pi\xE8ge du chasseur. Riposte Carmin n'est pas une d\xE9fense
      \u2014 c'est une invitation. Elle dit \xE0 l'adversaire : 'Viens me frapper.'"
    ActionPointCost: 2
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 1
    Shape: 1
    Filter: 1
    Effects: []
    QuantumSpellIdValue: 20
    CombatRulesVersion: 74
  - SpellId: soulrender_cauterisation
    DisplayName: "Caut\xE9risation"
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: 1bfd4be4ee92f464e9c0e27f54f68805, type: 3}
    Description: "Retire instantan\xE9ment tous les DoT actifs sur le Soulrender
      (poison, plaie ouverte, autres saignements ennemis). Le Soulrender se soigne
      de 60 HP par DoT retir\xE9 (min 60, max 180)."
    LoreFlavor: "L'auto-caut\xE9risation. Anti-Necram et anti-Ghostra. Quand le bleed
      devient trop dense, le Soulrender br\xFBle ses propres plaies pour repartir."
    ActionPointCost: 2
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 1
    Shape: 1
    Filter: 1
    Effects: []
    QuantumSpellIdValue: 21
    CombatRulesVersion: 74
  - SpellId: soulrender_peau_de_fer
    DisplayName: Peau de Fer
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: c950ce5e96a73b544b8bdbd9513b3f20, type: 3}
    Description: "Le Soulrender gagne un BOUCLIER de 200 HP pendant 2 tours. Pendant
      la dur\xE9e du bouclier, ses sorts \xE0 port\xE9e 1 (m\xEAl\xE9e) gagnent +30
      d\xE9g\xE2ts. Le bouclier se vide normalement aux d\xE9g\xE2ts subis."
    LoreFlavor: "Le mur viandard. Peau de Fer ne fait pas que prot\xE9ger \u2014
      elle ENCOURAGE l'engagement. Anti-Colossar/Nightseer qui zone \xE0 distance."
    ActionPointCost: 3
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 1
    Shape: 1
    Filter: 1
    Effects: []
    QuantumSpellIdValue: 22
    CombatRulesVersion: 74
  - SpellId: soulrender_seve_vive
    DisplayName: "S\xE8ve Vive"
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: 5e40e987d08ebb7478790186023771ce, type: 3}
    Description: 'Le Soulrender se soigne de 100 HP. Avec 1 HG : 160 HP. Si le Soulrender
      saigne actuellement (DoT actif sur lui) : +50 HP additionnels.'
    LoreFlavor: "Le rapide. S\xE8ve Vive est le micro-heal qui maintient le Soulrender
      en vie sans qu'il quitte le combat."
    ActionPointCost: 2
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 1
    Shape: 1
