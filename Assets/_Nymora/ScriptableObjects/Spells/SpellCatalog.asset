    QuantumSpellIdValue: 33
    CombatRulesVersion: 139
  - SpellId: nightseer_salve_mortelle
    DisplayName: Salve Mortelle
    ClassId: 2
    Category: 1
    IconSprite: {fileID: 21300000, guid: a9ce94dbed9fdab4e92885412bdd07d3, type: 3}
    Description: "Carr\xE9 plein 3x3 (9 cases) : 160 d\xE9g\xE2ts au centre, 90 sur
      les 8 cases autour. Chaque pi\xE8ge \xE0 toi sous la zone ajoute +40 d\xE9g\xE2ts
      SANS \xEAtre consomm\xE9 (tes pi\xE8ges restent pos\xE9s). Co\xFBte 3 PR. Relance
      : 2 tours."
    LoreFlavor: "Le moment o\xF9 la map r\xE9v\xE8le sa v\xE9rit\xE9. Salve Mortelle
      d\xE9chire toutes les illusions du Nightseer en m\xEAme temps."
    ActionPointCost: 5
    MovementPointCost: 0
    ClassResourceCost: 3
    CooldownTurns: 2
    MinRange: 1
    MaxRange: 6
    RequiresLineOfSight: 1
    Shape: 20
    Filter: 9
    Effects: []
    QuantumSpellIdValue: 34
    CombatRulesVersion: 139
  - SpellId: nightseer_marque_chasseur
    DisplayName: "Aff\xFBt"
    ClassId: 2
    Category: 2
    IconSprite: {fileID: 21300000, guid: 52ba33e8721255947b58fa5044483469, type: 3}
    Description: "Auto-buff : le Nightseer gagne +2 de PORT\xC9E sur ses sorts \xE0
      distance et +10% de d\xE9g\xE2ts pendant 2 tours. G\xE9n\xE8re +1 PR. Relance
      : 3 tours. INDISPONIBLE AU TOUR 1."
    LoreFlavor: "Se poster. L'Aff\xFBt n'est pas une attaque \u2014 c'est l'instant
      o\xF9 le chasseur s'immobilise, mesure le vent et la distance. Ce qui suit
      ne rate pas."
    ActionPointCost: 1
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 0
    Shape: 1
