    IconSprite: {fileID: 21300000, guid: bfc54f3b972344a45b5dabeb0c326815, type: 3}
    Description: "160 d\xE9g\xE2ts.\nCible TRAQU\xC9 : +120 d\xE9g\xE2ts (280) et
