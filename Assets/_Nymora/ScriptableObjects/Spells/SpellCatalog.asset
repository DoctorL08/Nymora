    CombatRulesVersion: 139
  - SpellId: soulrender_peau_de_fer
    DisplayName: Peau de Fer
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: c950ce5e96a73b544b8bdbd9513b3f20, type: 3}
    Description: "Le Soulrender gagne un BOUCLIER de 200 HP pendant 2 tours. Pendant
      la dur\xE9e du bouclier, ses sorts \xE0 port\xE9e 1 (m\xEAl\xE9e) gagnent +30
      d\xE9g\xE2ts. Le bouclier se vide normalement aux d\xE9g\xE2ts subis. Relance
      : 2 tours."
    LoreFlavor: "Le mur viandard. Peau de Fer ne fait pas que prot\xE9ger \u2014
      elle ENCOURAGE l'engagement. Anti-Colossar/Nightseer qui zone \xE0 distance."
    ActionPointCost: 3
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 0
    Shape: 1
    Filter: 1
    Effects: []
    QuantumSpellIdValue: 22
    CombatRulesVersion: 139
  - SpellId: soulrender_seve_vive
    DisplayName: "S\xE8ve Vive"
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: 5e40e987d08ebb7478790186023771ce, type: 3}
    Description: "Le Soulrender se soigne de 100 HP, ou 160 si tu as au moins 1 HG
      (d\xE9pens\xE9 automatiquement). Si le Soulrender saigne actuellement (DoT
      actif sur lui) : +50 HP additionnels. Cap : 1 fois par tour."
    LoreFlavor: "Le rapide. S\xE8ve Vive est le micro-heal qui maintient le Soulrender
      en vie sans qu'il quitte le combat."
    ActionPointCost: 2
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 0
    Shape: 1
    Filter: 1
    Effects: []
    QuantumSpellIdValue: 23
    CombatRulesVersion: 139
  - SpellId: soulrender_dernier_souffle
    DisplayName: Dernier Souffle
    ClassId: 1
    Category: 3
    IconSprite: {fileID: 21300000, guid: 2807cb681c8a2a94b8c86d5a8f8be925, type: 3}
    Description: "Utilisable uniquement \xE0 <30% HP. Le Soulrender se soigne de
      200 HP ET gagne 3 HG. UTILISABLE 1 FOIS PAR MATCH."
    LoreFlavor: "L'ultime. Dernier Souffle n'est pas un heal \u2014 c'est une renaissance.
      Le Soulrender qui aurait d\xFB mourir au tour 5 revient \xE0 50% HP avec 3
      HG en main, pr\xEAt pour un \xC2me Lac\xE9r\xE9e."
    ActionPointCost: 4
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
    MinRange: 0
    MaxRange: 0
    RequiresLineOfSight: 0
    Shape: 1
    Filter: 1
