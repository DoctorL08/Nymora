  - SpellId: necram_detonation_virulente
    DisplayName: "D\xE9tonation Virulente"
    ClassId: 4
    Category: 1
    IconSprite: {fileID: 21300000, guid: f1f91b3d0aee3274798e853631b1468c, type: 3}
