  - SpellId: soulrender_detonation_sanglante
    DisplayName: "D\xE9tonation Sanglante"
    ClassId: 1
    Category: 1
    IconSprite: {fileID: 21300000, guid: eb83950984866424aa5b299cdc9a01e0, type: 3}
    Description: "AoE croix 3. 60 d\xE9g\xE2ts + 40 par HG (2 \xE0 5 HG).\nAvec 5
      HG : 260 d\xE9g\xE2ts.\nSang Coagul\xE9 sous le centre (2 tours).\n5 HG ici
      \u2192 \xC2me Lac\xE9r\xE9e interdite (cooldown reset)."
    LoreFlavor: "Le payoff total. D\xE9toner 5 HG est un acte de FOI \u2014 le Soulrender
      renonce \xE0 son finisher pour un coup massif."
    ActionPointCost: 4
    MovementPointCost: 0
    ClassResourceCost: 2
    CooldownTurns: 0
    MinRange: 1
    MaxRange: 4
    RequiresLineOfSight: 1
    Shape: 10
