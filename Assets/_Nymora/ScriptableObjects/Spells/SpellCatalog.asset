    ClassId: 1
    Category: 1
    IconSprite: {fileID: 21300000, guid: 42eb5c642a861f2468e9e0b27236d024, type: 3}
    Description: "Fonce en ligne droite jusqu'au 1er obstacle.\n180 d\xE9g\xE2ts
      \xE0 la cible touch\xE9e.\nLaisse de la Vapeur Carmin sur le trajet (1 tour).\n1\xD7/tour."
    LoreFlavor: "Le b\xE9lier. Charge Brutale ne fait pas seulement entrer le Soulrender
      \u2014 elle CR\xC9E un couloir de pression qui restera apr\xE8s son passage."
    ActionPointCost: 3
    MovementPointCost: 0
    ClassResourceCost: 0
    CooldownTurns: 0
