  m_Script: {fileID: 11500000, guid: 1e8e35098b59b5942ab43cd2124cafb4, type: 3}
  m_Name: Ghostra
  m_EditorClassIdentifier: 
  ClassId: 5
  DisplayName: Ghostra
  AccentColor: {r: 0.43529412, g: 0.56078434, b: 0.65882355, a: 1}
  Tagline: Assassin dorsal. Leurres et desynchronisation. Frappe dans le dos.
  Lore: "Assassin spectral qui frappe l'angle mort. Sa Remanence est faite de leurres
    \u2014 clones visuels qui ne servent qu'a fragmenter l'attention adverse. Plus
    elle pose de leurres, plus son Angle Mort s'elargit, plus ses coups dorsaux deviennent
    letaux. Frappe Fantome, Saigne-Ame, Danse des Lames : ses combos exigent une
    lecture parfaite du regard adverse. Sa signature Execution Spectrale, dorsale
    obligatoire, peut finir un match en un seul tour."
  BaseHP: 1500
  BaseActionPoints: 8
  BaseMovementPoints: 3
  ResourceKind: 5
  ResourceCap: 3
  ResourceDescription: "REMANENCE \u2014 leurres spectraux poses sur la grille (max
    3). Modifient les sorts dorsaux selon leur densite."
  PassiveName: L'Angle Mort
  PassiveDescription: 'Systeme de DESYNCHRONISATION : les sorts dorsaux de la Ghostra
    sont modifies selon le nombre de leurres actifs. Plus de leurres = sorts plus
    letaux et imprevisibles.'
  SignatureName: "Ex\xE9cution Spectrale"
  SignatureCooldownTurns: 4
  SignatureDescription: Sort signature debloque a 3 leurres. Cooldown 4 tours apres
    usage.
  IconSprite: {fileID: 0}
  PortraitSprite: {fileID: 0}
