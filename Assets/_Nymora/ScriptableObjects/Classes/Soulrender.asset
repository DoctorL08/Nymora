  m_Script: {fileID: 11500000, guid: 1e8e35098b59b5942ab43cd2124cafb4, type: 3}
  m_Name: Soulrender
  m_EditorClassIdentifier: 
  ClassId: 1
  DisplayName: Soulrender
  AccentColor: {r: 0.69803923, g: 0.13333334, b: 0.13333334, a: 1}
  Tagline: Berserker melee. Subir = generer. Plus on le frappe, plus il s'arme.
  Lore: "Berserker melee assoiffe de combat. Plus on le frappe, plus il s'arme. Sa
    ressource Hemoglyphe se nourrit de la douleur \u2014 la sienne, celle qu'il inflige.
    Au seuil de la mort, il devient une lame qu'aucun bouclier n'arrete. Sa signature
    Ame Laceree consume tout son sang pour un coup definitif."
  BaseHP: 2000
  BaseActionPoints: 8
  BaseMovementPoints: 3
  ResourceKind: 1
  ResourceCap: 5
  ResourceDescription: "HEMOGLYPHE \u2014 ressource bilaterale : subir des degats
    ET en infliger en melee genere de la ressource. Aura rouge progressive, fissures
    ecarlates a 5/5."
  PassiveName: L'Appel du Sang
  PassiveDescription: 'Montee non-lineaire indexee sur les PV de la CIBLE (pas de
    palier de jauge) : cible >70% PV, aucun bonus. Cible <70% PV (Marquage) : tous
    tes sorts coutent -1 PA (min 1). Cible <40% PV (Rage Ouverte) : tes sorts de
    melee ignorent 50% du bouclier de la cible. Cible <20% PV (Le Cri) : du Sang
    Coagule nait en croix de 5 cases autour de toi (30 degats par debut de tour,
    pendant 2 tours).'
  SignatureName: "Ame Lac\xE9r\xE9ee"
  SignatureCooldownTurns: 4
  SignatureDescription: Sort signature debloque a 5 HG. Cooldown 4 tours apres usage.
  IconSprite: {fileID: 0}
  PortraitSprite: {fileID: 0}
