# =============================================================================
# Nymora — .editorconfig
# Regles de formatage appliquees par tous les IDE compatibles (VS, VS Code, Rider).
# Voir https://editorconfig.org pour la syntaxe.
# =============================================================================

root = true

# -----------------------------------------------------------------------------
# Defaults pour tous les fichiers
# -----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# -----------------------------------------------------------------------------
# Markdown : preserver les espaces de fin (ils servent au line break)
# -----------------------------------------------------------------------------
[*.md]
trim_trailing_whitespace = false

# -----------------------------------------------------------------------------
# YAML / JSON : indent 2 par convention
# -----------------------------------------------------------------------------
[*.{yml,yaml,json}]
indent_size = 2

# -----------------------------------------------------------------------------
# Unity assets (.unity, .prefab, .asset, .meta) — YAML, indent 2
# -----------------------------------------------------------------------------
[*.{unity,prefab,asset,meta,mat,anim,controller,physicMaterial,physicsMaterial2D}]
indent_size = 2

# -----------------------------------------------------------------------------
# C# — regles de style Nymora
# -----------------------------------------------------------------------------
[*.cs]
indent_size = 4

# Nouvelle ligne avant les accolades (style "Allman" — convention Microsoft/Unity)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Espaces
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

# Wrapping
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Naming conventions (camelCase pour locales, _camelCase pour fields prives, PascalCase pour public)
dotnet_naming_rule.private_fields_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style = prefix_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.prefix_underscore.required_prefix = _
dotnet_naming_style.prefix_underscore.capitalization = camel_case

# Var preferences (Unity convention : explicit types pour les API Unity, var pour le reste)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Modifier order
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# Unused parameters / variables
dotnet_diagnostic.IDE0060.severity = suggestion
dotnet_code_quality_unused_parameters = all:suggestion

# -----------------------------------------------------------------------------
# Roslyn Analyzers — Microsoft.CodeAnalysis.NetAnalyzers (CA*)
# Voir aussi : Assets/_Nymora/AnalyzerConfig/Nymora.ruleset
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1825.severity = warning  # Avoid zero-length array allocations
dotnet_diagnostic.CA1827.severity = warning  # Don't use Count/LongCount when Any can be used
dotnet_diagnostic.CA1828.severity = warning  # Don't use CountAsync when AnyAsync
dotnet_diagnostic.CA1841.severity = warning  # Prefer Dictionary Contains methods
dotnet_diagnostic.CA1854.severity = warning  # Prefer TryGetValue over ContainsKey + indexer
dotnet_diagnostic.CA1822.severity = suggestion  # Member can be marked static
dotnet_diagnostic.CA2208.severity = warning  # Instantiate argument exceptions correctly
dotnet_diagnostic.CA2245.severity = warning  # Don't assign a property to itself

dotnet_diagnostic.CA1707.severity = none  # Identifiers shouldn't have underscores (FALSE friend Unity)
dotnet_diagnostic.CA1305.severity = none  # Specify IFormatProvider (trop verbeux)
dotnet_diagnostic.CA2007.severity = none  # ConfigureAwait — pas applicable Unity

# -----------------------------------------------------------------------------
# Microsoft.Unity.Analyzers (UNT*)
# Activé une fois le DLL installé dans Assets/Plugins/Analyzers/
# Voir tools/install-unity-analyzers.ps1
# -----------------------------------------------------------------------------
dotnet_diagnostic.UNT0001.severity = warning  # Empty Unity message
dotnet_diagnostic.UNT0002.severity = warning  # Inefficient tag comparison (use CompareTag)
dotnet_diagnostic.UNT0003.severity = warning  # Use generic form of GetComponent
dotnet_diagnostic.UNT0004.severity = error    # Time.fixedDeltaTime used with Update (anti-déterminisme)
dotnet_diagnostic.UNT0005.severity = error    # Time.deltaTime used with FixedUpdate (anti-déterminisme)
dotnet_diagnostic.UNT0006.severity = warning  # Incorrect message signature
dotnet_diagnostic.UNT0007.severity = warning  # Null comparison against Unity object
dotnet_diagnostic.UNT0008.severity = warning  # Null propagation on Unity object
dotnet_diagnostic.UNT0014.severity = warning  # GetComponent called with non-Component
dotnet_diagnostic.UNT0017.severity = warning  # SetPixels invocation is slow
dotnet_diagnostic.UNT0023.severity = warning  # Coroutine using non-yieldable type
